---
interface Props { wind?: boolean; car?: boolean; label?: string }
const { wind = false, car = true, label } = Astro.props;
const u = Math.random().toString(36).slice(2, 7);
---
<svg class="ill-anim ill-house" viewBox="0 0 600 380" role="img" aria-label="Ilustracija: kuća sa solarnim panelima, kućnom baterijom i električnim autom na punjenju">
  <defs>
    <linearGradient id={`sky${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7E6B0" /><stop offset="1" stop-color="#FBF4E2" /></linearGradient>
    <radialGradient id={`glow${u}`}><stop offset=".45" stop-color="#F2C318" stop-opacity=".55" /><stop offset="1" stop-color="#F2C318" stop-opacity="0" /></radialGradient>
    <linearGradient id={`ground${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#D9C98F" /><stop offset="1" stop-color="#C9B678" /></linearGradient>
    <linearGradient id={`roof${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#B8232C" /><stop offset="1" stop-color="#8E161E" /></linearGradient>
    <linearGradient id={`panel${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2E3F63" /><stop offset="1" stop-color="#1C2740" /></linearGradient>
    <linearGradient id={`win${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE17A" /><stop offset="1" stop-color="#F2C318" /></linearGradient>
    <linearGradient id={`car${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3B7FD6" /><stop offset="1" stop-color="#2459A3" /></linearGradient>
    <clipPath id={`pclip${u}`}><rect x="4" y="16" width="96" height="24" rx="2" /></clipPath>
  </defs>

  <rect width="600" height="380" fill={`url(#sky${u})`} />
  <circle cx="500" cy="80" r="86" fill={`url(#glow${u})`} class="a-breathe" />
  <g class="a-spin-slow" style="transform-origin: 500px 80px">
    <g stroke="#E8B300" stroke-width="5" stroke-linecap="round"><path d="M500 10v14M570 80h-14M430 80h14M500 150v-14M549 31l-10 10M451 31l10 10M549 129l-10-10M451 129l10-10" /></g>
  </g>
  <circle cx="500" cy="80" r="40" fill="#F2C318" />
  <circle cx="488" cy="68" r="14" fill="#FFE17A" opacity=".7" />

  <g class="a-drift" fill="#fff" opacity=".85">
    <path d="M250 70a16 16 0 0 1 30-8 13 13 0 0 1 22 10h-52z" />
    <path d="M360 40a12 12 0 0 1 22-6 10 10 0 0 1 17 8h-39z" opacity=".7" />
  </g>

  <path d="M0 330q150-22 300-6t300-10v66H0z" fill={`url(#ground${u})`} />
  <ellipse cx="275" cy="333" rx="150" ry="7" fill="#16181B" opacity=".12" />

  {wind ? (
    <g>
      <path d="M86 332l2-208h4l2 208z" fill="#16181B" />
      <g class="a-rotor" style="transform-origin: 90px 120px">
        <g fill="#fff" stroke="#16181B" stroke-width="2.5" stroke-linejoin="round">
          <path d="M90 120q-9-40-2-82 6 0 8 4 3 40-6 78z" />
          <path d="M90 120q-9-40-2-82 6 0 8 4 3 40-6 78z" transform="rotate(120 90 120)" />
          <path d="M90 120q-9-40-2-82 6 0 8 4 3 40-6 78z" transform="rotate(240 90 120)" />
        </g>
      </g>
      <circle cx="90" cy="120" r="8" fill="#A51C24" stroke="#16181B" stroke-width="2" />
    </g>
  ) : (
    <g class="a-sway" style="transform-origin: 80px 330px">
      <path d="M80 332v-62" stroke="#5B3A22" stroke-width="6" stroke-linecap="round" />
      <circle cx="80" cy="254" r="36" fill="#2F8F46" />
      <circle cx="66" cy="242" r="16" fill="#3FA75A" />
      <circle cx="96" cy="262" r="12" fill="#26773A" />
    </g>
  )}

  <!-- kuća -->
  <rect x="352" y="132" width="20" height="40" fill="#8E161E" stroke="#16181B" stroke-width="2.5" />
  <rect x="150" y="200" width="240" height="132" fill="#fff" stroke="#16181B" stroke-width="3" />
  <rect x="153" y="203" width="234" height="10" fill="#16181B" opacity=".08" />
  <path d="M128 207L270 108l142 99z" fill={`url(#roof${u})`} stroke="#16181B" stroke-width="3" stroke-linejoin="round" />
  <path d="M170 186l100-70" stroke="#fff" stroke-opacity=".18" stroke-width="3" />

  <!-- solarni paneli -->
  <g transform="translate(288 124) rotate(34.44)">
    <rect x="1" y="13" width="102" height="30" rx="3" fill="#16181B" />
    <rect x="4" y="16" width="96" height="24" rx="2" fill={`url(#panel${u})`} />
    <g stroke="#7FA3D9" stroke-width="1.2" opacity=".8"><path d="M28 16v24M52 16v24M76 16v24M4 28h96" /></g>
    <g clip-path={`url(#pclip${u})`}><rect class="a-shine" x="-40" y="0" width="22" height="40" fill="#fff" opacity=".35" transform="skewX(-20)" /></g>
  </g>

  <rect x="178" y="236" width="60" height="48" fill={`url(#win${u})`} stroke="#16181B" stroke-width="2.5" />
  <path d="M208 236v48M178 260h60" stroke="#16181B" stroke-width="2" />
  <rect x="174" y="284" width="68" height="6" rx="2" fill="#16181B" />
  <rect x="288" y="256" width="46" height="76" rx="2" fill="#16181B" />
  <rect x="294" y="262" width="34" height="26" rx="1" fill="#2E3F63" />
  <circle cx="324" cy="300" r="2.5" fill="#F2C318" />

  <!-- baterija -->
  <rect x="346" y="262" width="34" height="58" rx="7" fill="#2F8F46" stroke="#16181B" stroke-width="2.5" />
  <g fill="#F2C318"><rect class="a-charge" x="353" y="306" width="20" height="6" rx="2" /><rect class="a-charge" x="353" y="297" width="20" height="6" rx="2" style="animation-delay: .4s" /><rect class="a-charge" x="353" y="288" width="20" height="6" rx="2" style="animation-delay: .8s" /></g>
  <path d="M367 268l-6 11h8l-6 11" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M370 196v66" stroke="#16181B" stroke-width="2" />
  <path class="a-flow" d="M370 196v66" stroke="#F2C318" stroke-width="2" stroke-dasharray="4 10" />

  {car && (
    <g>
      <path d="M380 300q34 0 58 24" fill="none" stroke="#16181B" stroke-width="3.5" stroke-linecap="round" />
      <path class="a-flow" d="M380 300q34 0 58 24" fill="none" stroke="#F2C318" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 10" />
      <ellipse cx="484" cy="345" rx="64" ry="5" fill="#16181B" opacity=".15" />
      <path d="M426 332v-14q0-10 10-12l20-4 18-18q6-6 16-6h28q10 0 15 7l14 17q12 2 14 12v18z" fill={`url(#car${u})`} stroke="#16181B" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M466 302l14-14q3-3 8-3h12v17zM506 285h10q5 0 8 4l10 13h-28z" fill="#CFE0F5" stroke="#16181B" stroke-width="2" stroke-linejoin="round" />
      <rect x="548" y="312" width="10" height="6" rx="2" fill="#FFE17A" />
      <g><circle cx="452" cy="334" r="13" fill="#16181B" /><circle cx="452" cy="334" r="5" fill="#9A9DA2" /><circle cx="530" cy="334" r="13" fill="#16181B" /><circle cx="530" cy="334" r="5" fill="#9A9DA2" /></g>
      <circle class="a-blink" cx="440" cy="318" r="3" fill="#3FD16A" />
    </g>
  )}

  {label && (
    <g>
      <rect x="24" y="30" width="200" height="74" rx="18" fill="#fff" stroke="#16181B" stroke-width="2.5" />
      <text x="42" y="56" fill="#55524B" font-family="IBM Plex Mono, monospace" font-size="11">{label}</text>
      <text x="42" y="88" fill="#16181B" font-family="Archivo Variable, sans-serif" font-weight="800" font-size="24">[X] kWh</text>
      <circle class="a-blink" cx="204" cy="52" r="5" fill="#2F8F46" />
    </g>
  )}
</svg>
