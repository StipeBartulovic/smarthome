---
const u = Math.random().toString(36).slice(2, 7);
// Prozori koji se pale/gase u petlji (redoslijed kašnjenja da izgleda nasumično)
const delays = [0, 2.1, 0.7, 3.4, 1.6, 4.2, 2.8, 0.3, 3.9, 1.1, 4.8, 2.4];
---
<svg class="ill-anim ill-building" viewBox="0 0 600 360" role="img" aria-label="Ilustracija: stambena zgrada s osvijetljenim prozorima, razvodnim ormarom i pametnim termostatom">
  <defs>
    <linearGradient id={`bsky${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E4DDCC" /><stop offset="1" stop-color="#EFEAE0" /></linearGradient>
    <linearGradient id={`bside${u}`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#E2DDD2" /><stop offset="1" stop-color="#CFC9BC" /></linearGradient>
    <linearGradient id={`bwin${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE17A" /><stop offset="1" stop-color="#F2C318" /></linearGradient>
    <linearGradient id={`bglass${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3B4C70" /><stop offset="1" stop-color="#1C2740" /></linearGradient>
  </defs>

  <rect width="600" height="360" fill={`url(#bsky${u})`} />
  <rect y="320" width="600" height="40" fill="#DCD6C9" />
  <path d="M0 320h600" stroke="#C8C1B2" stroke-width="2" />
  <ellipse cx="320" cy="323" rx="190" ry="6" fill="#16181B" opacity=".12" />

  <!-- paneli na krovu -->
  <g fill="#26344F" stroke="#16181B" stroke-width="1.5">
    <path d="M196 46l10-16h44l-6 16zM256 46l6-16h44l-2 16zM316 46l2-16h44l2 16zM376 46l-2-16h44l6 16z" />
  </g>
  <path d="M206 46v-4M244 46v-4" stroke="#16181B" stroke-width="2" />

  <!-- bočna strana (dubina) -->
  <path d="M430 60l34-14v262l-34 12z" fill={`url(#bside${u})`} stroke="#16181B" stroke-width="3" stroke-linejoin="round" />
  <g fill="#B9B2A3">{[85, 135, 185].map((y) => <path d={`M440 ${y + 2}l14-5v26l-14 5z`} />)}</g>
  <rect x="160" y="46" width="280" height="16" rx="3" fill="#16181B" />
  <path d="M440 46l30-12v14l-30 14z" fill="#16181B" />
  <rect x="170" y="60" width="260" height="260" fill="#fff" stroke="#16181B" stroke-width="3" />
  <path d="M170 120h260M170 170h260M170 220h260" stroke="#16181B" stroke-opacity=".06" stroke-width="2" />

  <g>
    {[85, 135, 185].map((y, r) => [195, 255, 315, 375].map((x, c) => (
      <g>
        <rect x={x} y={y} width="40" height="30" fill="#E9E4D8" stroke="#16181B" stroke-width="2" />
        <rect class="a-light" x={x + 1} y={y + 1} width="38" height="28" fill={`url(#bwin${u})`} style={`animation-delay: -${delays[r * 4 + c]}s`} />
        <path d={`M${x + 20} ${y}v30`} stroke="#16181B" stroke-width="1.5" />
        <rect x={x - 3} y={y + 30} width="46" height="4" rx="1" fill="#16181B" />
      </g>
    )))}
  </g>

  <!-- ulaz -->
  <rect x="262" y="256" width="76" height="6" rx="2" fill="#16181B" />
  <rect x="275" y="262" width="50" height="58" fill={`url(#bglass${u})`} stroke="#16181B" stroke-width="2.5" />
  <path d="M300 262v58" stroke="#16181B" stroke-width="2" />
  <path d="M280 300l14-30" stroke="#fff" stroke-opacity=".2" stroke-width="5" />
  <rect x="295" y="288" width="3" height="10" rx="1" fill="#F2C318" /><rect x="302" y="288" width="3" height="10" rx="1" fill="#F2C318" />

  <!-- razvodni ormar i kabel -->
  <path d="M93 320v24h207v-24" fill="none" stroke="#A51C24" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
  <path class="a-flow" d="M93 320v24h207v-24" fill="none" stroke="#FFE17A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 10" />
  <rect x="64" y="250" width="58" height="70" rx="5" fill="#16181B" />
  <rect x="64" y="250" width="58" height="10" rx="5" fill="#2A2D31" />
  <path class="a-zap" d="M98 266l-12 22h14l-12 22" fill="none" stroke="#F2C318" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

  <!-- stablo -->
  <g class="a-sway" style="transform-origin: 510px 320px">
    <path d="M510 320v-58" stroke="#5B3A22" stroke-width="6" stroke-linecap="round" />
    <circle cx="510" cy="244" r="36" fill="#2F8F46" />
    <circle cx="496" cy="232" r="16" fill="#3FA75A" />
    <circle cx="526" cy="254" r="12" fill="#26773A" />
  </g>

  <!-- termostat -->
  <g class="a-float">
    <rect x="446" y="80" width="128" height="74" rx="14" fill="#16181B" opacity=".1" transform="translate(4 6)" />
    <rect x="442" y="76" width="128" height="74" rx="14" fill="#fff" stroke="#16181B" stroke-width="2.5" />
    <text x="458" y="98" fill="#55524B" font-family="IBM Plex Mono, monospace" font-size="11">PAMETNA KUĆA</text>
    <text x="458" y="130" fill="#16181B" font-family="Archivo Variable, sans-serif" font-weight="800" font-size="26">22 °C</text>
    <circle cx="550" cy="122" r="9" fill="#2F8F46" opacity=".25" class="a-ping" style="transform-origin: 550px 122px" />
    <circle cx="550" cy="122" r="6" fill="#2F8F46" />
    <rect x="458" y="138" width="96" height="4" rx="2" fill="#E9E4D8" />
    <rect x="458" y="138" width="62" height="4" rx="2" fill="#2F8F46" />
  </g>
</svg>
