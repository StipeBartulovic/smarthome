---
interface Props { size?: number; variant?: 'light' | 'dark' }
const { size = 46, variant = 'light' } = Astro.props;
const red = variant === 'dark' ? '#E0434B' : '#A51C24';
const green = variant === 'dark' ? '#3FB35B' : '#2F8F46';
const yellow = variant === 'dark' ? '#F2C318' : '#E8B300';
---
<svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M7.09 17.84A18 18 0 0 1 40.91 17.84M7.09 30.16A18 18 0 0 0 40.91 30.16" stroke={red} />
  <path d="M1.5 24H13M35 24h11.5" stroke={green} />
  <path d="M13 24l5-11v22l12-22v22l5-11" stroke={yellow} />
</svg>
