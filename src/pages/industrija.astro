---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';
import Factory from '../components/ill/Factory.astro';

const variants = [
  { key: 'a', label: 'Serija A', color: 'var(--yellow)', status: 'S1 · S2 · S4 aktivne', text: 'Serija A koristi tri stanice; S3 je odspojena i spremna za drugi posao.' },
  { key: 'b', label: 'Serija B', color: 'var(--n)', status: 'S1 · S3 · S4 aktivne', text: 'Za seriju B stanica S2 se odspaja, a S3 uključuje — bez novog ožičenja linije.' },
  { key: 'c', label: 'Serija C', color: 'var(--red-light)', status: 'S1 · S2 · S3 aktivne', text: 'Serija C završava na S3. Alati i strojevi brzo se prespajaju, a proizvodnja ostaje lean.' },
];
const stations = [80, 210, 340, 470];
---
<Base title="Industrija" description="Elektroinstalacije za pametne tvornice: E-plan i BIM projektiranje, integracija sustava, Electricity 4.0 i manje zastoja." active="usluge" bodyClass="bg-cool">
  <section class="bg-ink">
    <div class="wrap stack" style="padding-block: 36px var(--section); --gap: 32px">
      <div class="row" style="justify-content: space-between">
        <Crumbs items={[{ label: 'Industrija' }]} />
        <nav class="row" aria-label="Industrija" style="--gap: 6px">
          <a class="btn btn--ghost btn--ghost-dark" style="min-height: 44px; padding: 10px 16px; font-size: 15px" href="#linija">Pametne tvornice</a>
          <a class="btn btn--ghost btn--ghost-dark" style="min-height: 44px; padding: 10px 16px; font-size: 15px" href="#softver">E-plan i BIM</a>
          <a class="btn btn--ghost btn--ghost-dark" style="min-height: 44px; padding: 10px 16px; font-size: 15px" href="#odrzavanje">Održavanje</a>
        </nav>
      </div>
      <div class="split">
        <div class="stack" style="--gap: 24px">
          <span class="eyebrow"><span class="dot c-l2" style="box-shadow: 0 0 0 2px #9A9DA2"></span>L2 · Industrija</span>
          <h1 class="h1 wide">Pogon koji<br /><span class="t-yellow">ne staje.</span></h1>
          <p class="lead">Aktivno sudjelujemo u razvoju pametnih tvornica: projektiramo i izvodimo sve elektroinstalacije unutar integriranih industrijskih sustava — interoperabilno, robusno i pouzdano.</p>
          <a class="btn btn--red" href="/kontakt" style="align-self: flex-start">Dogovorite obilazak pogona <span aria-hidden="true">→</span></a>
        </div>
        <div class="ill" style="background: var(--cool-2)"><Factory /></div>
      </div>
    </div>
  </section>

  <section id="linija" class="wrap section">
    <div class="head">
      <div class="stack" style="--gap: 16px"><p class="eyebrow eyebrow--red">Agilno, svestrano, robusno</p><h2 class="h2 wide">Jedna linija. Više proizvoda.</h2></div>
      <p>Moderne tvornice trebaju brzo proizvoditi manje, prilagođene serije ili više proizvoda na jednoj liniji. Isprobajte prespajanje.</p>
    </div>
    <div class="card line-demo" data-state-group data-state="a" style="border-radius: 36px">
      <div class="row" style="justify-content: space-between">
        <div class="seg" role="group" aria-label="Odaberite seriju">
          {variants.map((v) => <button type="button" data-set={v.key} aria-pressed="false"><span class="dot" style={`--c: ${v.color}; border-radius: 3px`}></span>{v.label}</button>)}
        </div>
        {variants.map((v) => <span class="mono small muted" data-show={v.key} hidden>{v.status}</span>)}
      </div>
      <div class="stage-svg" style="background: var(--night)">
        <svg viewBox="0 0 640 320" role="img" aria-label="Proizvodna linija s četiri stanice; odabrana serija uključuje različite stanice">
          <rect y="280" width="640" height="40" fill="#2A2D31" />
          <path d="M30 60h580" stroke="#F2C318" stroke-width="5" stroke-linecap="round" />
          <circle cx="30" cy="60" r="9" fill="#F2C318" />
          <text x="30" y="40" fill="#9A9DA2" font-family="IBM Plex Mono, monospace" font-size="11">SABIRNICA</text>
          {stations.map((x, i) => (
            <g class={`s${i}`}>
              <path class="drop" d={`M${x + 45} 60v50`} stroke-width="4" />
              <rect class="st" x={x} y="110" width="90" height="100" rx="8" stroke="#5A5E64" stroke-width="2" />
              <text class="st-t" x={x + 45} y="166" text-anchor="middle" font-family="Archivo Variable, sans-serif" font-weight="800" font-size="20">S{i + 1}</text>
            </g>
          ))}
          <rect x="30" y="246" width="580" height="14" rx="7" fill="#5A5E64" />
          {stations.map((x) => <rect class="prod" x={x + 24} y="224" width="30" height="22" stroke="#16181B" stroke-width="2" />)}
          <path d="M590 236h30l-10-8" fill="none" stroke="#9A9DA2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      {variants.map((v) => <p data-show={v.key} hidden style="color: #3A3F44">{v.text}</p>)}
    </div>
  </section>

  <section class="bg-white" style="border-block: 1px solid #D3D9DE">
    <div class="wrap section grid" style="--min: 320px; --gap: 20px">
      <article class="card bg-cool" style="border-radius: 32px">
        <svg viewBox="0 0 200 120" style="max-width: 240px" aria-hidden="true"><circle cx="60" cy="60" r="34" fill="#7A4A2A" fill-opacity=".85" /><circle cx="100" cy="60" r="34" fill="#2D6CC0" fill-opacity=".85" /><circle cx="140" cy="60" r="34" fill="#F2C318" fill-opacity=".85" /></svg>
        <span class="mono small muted">01</span>
        <h2 class="h4" style="font-size: 28px">Multidisciplinarni timovi</h2>
        <p style="color: #3A3F44">Naši stručnjaci rade unutar multidisciplinarnih timova kako bi optimizirali energetska svojstva zgrade tvornice i sve njezine električne opreme.</p>
      </article>
      <article id="softver" class="card bg-ink" style="border-radius: 32px">
        <svg viewBox="0 0 200 120" style="max-width: 240px" aria-hidden="true"><path d="M100 20l70 25-70 25-70-25z" fill="none" stroke="#9A9DA2" stroke-width="2" /><path d="M100 38l70 25-70 25-70-25z" fill="none" stroke="#2D6CC0" stroke-width="2.5" /><path d="M100 56l70 25-70 25-70-25z" fill="#F2C318" stroke="#F2C318" stroke-width="2" /><path d="M100 70v36" stroke="#A51C24" stroke-width="3" /></svg>
        <span class="mono small muted">02</span>
        <h2 class="h4" style="font-size: 28px">E-plan i BIM</h2>
        <p style="color: #D6D2C8">Najnoviji inženjerski softver daje dubinsku analizu konstrukcije i troškova svakog elementa instalacije — i njegove integracije u pametnu tvornicu.</p>
      </article>
      <article id="odrzavanje" class="card bg-cool" style="border-radius: 32px">
        <svg viewBox="0 0 200 120" style="max-width: 240px" aria-hidden="true"><rect x="20" y="30" width="160" height="22" rx="11" fill="#C5CDD3" /><rect x="20" y="30" width="120" height="22" rx="11" fill="#A51C24" /><rect x="20" y="70" width="160" height="22" rx="11" fill="#C5CDD3" /><rect x="20" y="70" width="44" height="22" rx="11" fill="#2F8F46" /></svg>
        <span class="mono small muted">03</span>
        <h2 class="h4" style="font-size: 28px">Manje zastoja</h2>
        <p style="color: #3A3F44">Electricity 4.0 smanjuje zastoje strojeva i omogućuje inženjerima da ih zamijene ili poprave brzo i uz manje troškove.</p>
      </article>
    </div>
  </section>

  <section class="wrap section split">
    <div class="stack">
      <p class="eyebrow eyebrow--red">Industrijski internet stvari</p>
      <h2 class="h2 wide">Vaša tvornica dobiva Electricity 4.0.</h2>
      <p style="color: #3A3F44">IIoT mijenja upravljanje, održavanje i produktivnost industrije. Mi se brinemo da vaš pogon bude spreman — uz očuvanje lean proizvodnog procesa.</p>
    </div>
    <div class="photo-frame" style="min-height: 380px"><Photo name="pogon" alt="Inženjer provjerava industrijski upravljački ormar u proizvodnoj hali" style="position: absolute; inset: 0" /></div>
  </section>

  <Cta title="Planirate novi pogon ili nadogradnju?" tone="ink" secondary={{ label: 'Pošaljite projektni zadatak', href: '/kontakt' }} />
</Base>
