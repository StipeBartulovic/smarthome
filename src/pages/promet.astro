---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Photo from '../components/Photo.astro';
import Cta from '../components/Cta.astro';

const phases = [
  { label: 'Izgradnja', title: 'Nova prometnica', text: 'Električna infrastruktura nove ceste — od projekta i trasiranja kabela do puštanja u rad.' },
  { label: 'Rekonstrukcija', title: 'Obnova postojećeg', text: 'Zamjena dotrajalih instalacija i modernizacija električne infrastrukture postojeće ceste.' },
  { label: 'Servis', title: 'Intervencija na terenu', text: 'Servis i popravci kad nešto zakaže — da cesta ostane sigurna.' },
  { label: 'Održavanje', title: 'Dugoročno pouzdano', text: 'Redovito održavanje za kvalitetu, sigurnost i trajnost infrastrukture.' },
];
---
<Base title="Promet" description="Električna infrastruktura cesta tijekom izgradnje, rekonstrukcije, servisa i održavanja — kvaliteta, sigurnost i trajnost." active="usluge" bodyClass="bg-cool">
  <section class="bg-night">
    <div class="wrap stack" style="padding-block: 36px var(--section); --gap: 36px">
      <Crumbs items={[{ label: 'Promet' }]} />
      <div class="split split--end">
        <div class="stack grow-2" style="--gap: 20px">
          <span class="eyebrow"><span class="dot c-l3"></span>L3 · Promet</span>
          <h1 class="h1 wide">Svjetlo na svakom<br /><span class="t-yellow">kilometru.</span></h1>
        </div>
        <p class="lead">Profesionalna rješenja za električnu infrastrukturu cesta — tijekom izgradnje, rekonstrukcije, servisa i održavanja.</p>
      </div>

      <div class="road stack" data-state-group data-state="0" style="background: var(--ink); border-radius: 36px; padding: clamp(16px, 2.5vw, 28px); --gap: 20px">
        <div class="phase-btns" role="group" aria-label="Faza životnog ciklusa ceste">
          {phases.map((p, i) => <button type="button" data-set={String(i)} aria-pressed="false"><span class="tm">0{i + 1}</span>{p.label}</button>)}
        </div>
        <div class="stage-svg">
          <svg viewBox="0 0 900 400" role="img" aria-label="Cesta noću s rasvjetom; prikaz se mijenja prema odabranoj fazi">
            <rect width="900" height="400" fill="#1E2430" />
            <circle cx="110" cy="60" r="24" fill="#F6F3EC" />
            <g fill="#F6F3EC"><circle cx="260" cy="40" r="2" /><circle cx="480" cy="70" r="2" /><circle cx="700" cy="36" r="2" /></g>
            <path d="M0 200l180-32 160 18 140-26 160 22 260-18v236H0z" fill="#283041" />
            <path d="M400 180h100l400 220H0z" fill="#3A4252" />
            <g fill="#F2C318"><path d="M446 192h8l2 26h-12zM442 246h16l4 44h-24zM434 326h32l6 64h-44z" /></g>
            <path class="cone-l" d="M226 166h36l118 214H110z" fill="#F2C318" />
            <path class="cone-r" d="M638 166h36l116 214H520z" fill="#F2C318" />
            <path d="M170 400V160h76M730 400V160h-76" fill="none" stroke="#9A9DA2" stroke-width="7" stroke-linecap="round" />
            <rect class="lamp-l" x="224" y="157" width="42" height="12" rx="3" />
            <rect class="lamp-r" x="634" y="157" width="42" height="12" rx="3" />
            <g class="ov ov-0">
              <path d="M40 388l340-138" stroke="#C77A45" stroke-width="10" stroke-dasharray="18 10" />
              <rect x="290" y="330" width="120" height="16" fill="#E0434B" />
              <g fill="#F6F3EC"><rect x="300" y="330" width="16" height="16" /><rect x="332" y="330" width="16" height="16" /><rect x="364" y="330" width="16" height="16" /></g>
              <path d="M303 346v34M397 346v34" stroke="#9A9DA2" stroke-width="6" />
            </g>
            <g class="ov ov-1" font-family="IBM Plex Mono, monospace" font-size="13">
              <rect x="606" y="110" width="90" height="30" rx="15" fill="#F6F3EC" /><text x="651" y="131" text-anchor="middle" fill="#16181B">NOVO</text>
              <rect x="194" y="110" width="90" height="30" rx="15" fill="#5A5E64" /><text x="239" y="131" text-anchor="middle" fill="#F6F3EC">STARO</text>
            </g>
            <g class="ov ov-2">
              <rect x="740" y="318" width="120" height="54" rx="8" fill="#F2C318" stroke="#16181B" stroke-width="2" />
              <rect x="824" y="296" width="36" height="30" rx="4" fill="#F2C318" stroke="#16181B" stroke-width="2" />
              <circle cx="766" cy="374" r="12" fill="#0B0C0D" /><circle cx="840" cy="374" r="12" fill="#0B0C0D" />
              <path d="M770 318l-30-78-50-50" fill="none" stroke="#F6F3EC" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="672" y="176" width="36" height="22" rx="3" fill="#E0434B" />
            </g>
            <g class="ov ov-3"><circle cx="820" cy="80" r="34" fill="#2F8F46" /><path d="M804 80l12 12 22-24" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" /></g>
          </svg>
        </div>
        {phases.map((p, i) => (
          <div class="row" data-show={String(i)} hidden style="--gap: 12px 32px; align-items: baseline">
            <strong class="h4 wide" style="font-size: 26px">{p.title}</strong>
            <span style="color: #D6D2C8; flex: 1 1 360px">{p.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="head"><div class="stack" style="--gap: 16px"><p class="eyebrow eyebrow--red">Naš primarni cilj</p><h2 class="h2 wide">Infrastruktura koja se ističe.</h2></div></div>
    <div class="grid" style="--min: 260px">
      <div class="card card--top c-yellow"><div class="bar"></div><div class="body"><span class="display wide" style="font-size: 40px; line-height: 1">Kvaliteta</span><span style="color: #3A3F44">Izvedba po pravilima struke, od projekta do predaje.</span></div></div>
      <div class="card card--top"><div class="bar" style="background: var(--pe-sm)"></div><div class="body"><span class="display wide" style="font-size: 40px; line-height: 1">Sigurnost</span><span style="color: #3A3F44">Za vozače, pješake i ekipe na terenu.</span></div></div>
      <div class="card card--top c-l3"><div class="bar"></div><div class="body"><span class="display wide" style="font-size: 40px; line-height: 1">Trajnost</span><span style="color: #3A3F44">Infrastruktura koja služi godinama, uz redovito održavanje.</span></div></div>
    </div>
  </section>

  <section class="bg-white" style="border-block: 1px solid #D3D9DE">
    <div class="wrap section split split--top">
      <div class="stack">
        <h2 class="h3 wide">Za investitore, izvođače i uprave za ceste</h2>
        <ul class="lines" style="border-top-width: 2px">
          <li><span style="font-weight: 500">Električna infrastruktura novih prometnica</span></li>
          <li><span style="font-weight: 500">Rekonstrukcija postojećih instalacija</span></li>
          <li><span style="font-weight: 500">Servis i održavanje</span></li>
          <li><span class="muted">[VRSTA RADA — potvrditi s EKP-om, npr. rasvjeta, signalizacija, tuneli]</span></li>
        </ul>
      </div>
      <article class="card bg-cool" style="padding: 0; overflow: hidden; border-radius: 32px">
        <div class="photo-frame" style="height: 280px; border-radius: 0"><Photo name="cesta" alt="Obalna cesta u sumrak s uličnom rasvjetom i tehničarom uz stup" style="position: absolute; inset: 0" /></div>
        <div class="stack" style="padding: 28px; --gap: 10px">
          <span class="eyebrow" style="font-size: 12px">Referenca</span>
          <strong class="h4" style="font-size: 26px">[NAZIV DIONICE]</strong>
          <span class="mono small muted">[NARUČITELJ] · [km] · [GODINA]</span>
          <a class="link" href="/projekti">Svi projekti →</a>
        </div>
      </article>
    </div>
  </section>

  <Cta title="Imate dionicu? Pošaljite projektni zadatak." tone="ink" secondary={{ label: 'Kontakt', href: '/kontakt' }} />
</Base>
