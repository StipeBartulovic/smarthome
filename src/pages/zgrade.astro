---
import Base from '../layouts/Base.astro';
import SubNav from '../components/SubNav.astro';
import Crumbs from '../components/Crumbs.astro';
import Cta from '../components/Cta.astro';

const parts = [
  { label: 'Priključak na SN/NN mrežu', text: 'Od trafostanice do vaše zgrade, uz koordinaciju s nadležnim tijelima.' },
  { label: 'Energetski vodovi', text: 'Unutarnje i vanjsko ožičenje cijelog objekta.' },
  { label: 'Razvodni ormari', text: 'Raspodjela i zaštita svakog strujnog kruga u zgradi.' },
  { label: 'Rasvjeta', text: 'Unutarnja i vanjska rasvjeta, uključujući automatizaciju.' },
  { label: 'Solarni paneli', text: 'Vlastita struja s krova — pogledajte Fotonaponske sustave.' },
  { label: 'Pričuvni i nužni sustavi', text: 'Napajanje i kad mreža zakaže.' },
  { label: 'Prenaponska i gromobranska zaštita', text: 'Zaštita ljudi, zgrade i uređaja od munje i prenapona.' },
  { label: 'Sigurnost i vatrodojava', text: 'Detektori i nadzor — pogledajte Vatrodojavu.' },
];
---
<Base title="Zgrade — elektroinstalacije" description="Plug-and-play elektroinstalacije za kuće, stanove, vile i javne zgrade — projekt, dozvole, izvedba i nadzor do uporabne dozvole." active="usluge">
  <SubNav active="instalacije" />

  <section class="wrap" style="padding-block: 40px 64px">
    <div class="stack" style="--gap: 32px">
      <Crumbs items={[{ label: 'Zgrade' }]} />
      <div class="split split--end">
        <div class="stack grow-2" style="--gap: 20px">
          <span class="eyebrow"><span class="dot c-l1"></span>L1 · Zgrade · Elektroinstalacije</span>
          <h1 class="h1">Plug &amp; play.<br /><span class="t-l1">Od nacrta do prekidača.</span></h1>
        </div>
        <div class="stack">
          <p class="lead">Gradite ili renovirate — ožičit ćemo vaš projekt. Kuća, stan, vila ili javna zgrada, svejedno. Put od prvog nacrta do prekidača je bezbrižan i brz.</p>
          <a class="btn btn--red" href="/kontakt" style="align-self: flex-start">Zatraži ponudu <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERAKTIVNI PRESJEK -->
  <section class="wrap" style="padding-bottom: var(--section)">
    <div class="card card--line cut" data-state-group data-state="2" style="padding: clamp(18px, 3vw, 40px)">
      <div class="split">
        <div class="stage-svg grow-2" style="background: var(--stone); flex-basis: 520px">
          <svg viewBox="0 0 640 480" role="img" aria-label="Presjek zgrade s elektroinstalacijama; odabrani sustav istaknut je crvenom">
            <rect y="400" width="640" height="80" fill="#DCD6C9" />
            <rect class="hl p0" x="18" y="330" width="56" height="70" rx="4" fill="#5A5E64" stroke="#16181B" stroke-width="2.5" />
            <text x="34" y="320" fill="#55524B" font-family="IBM Plex Mono, monospace" font-size="11">TS</text>
            <path class="hl p0s" d="M46 400v46h124v-46" fill="none" stroke="#16181B" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M128 146L330 50l202 96z" fill="#A51C24" stroke="#16181B" stroke-width="3" stroke-linejoin="round" />
            <path class="hl p4" d="M352 72l104 48-16 10-104-48zM462 126l48 22-14 4-48-20z" fill="#26344F" stroke="#16181B" stroke-width="2" />
            <path class="hl p6" d="M330 50V16M526 146v254l30 40M540 440h32" fill="none" stroke="#5A5E64" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="150" y="140" width="360" height="260" fill="#fff" stroke="#16181B" stroke-width="3" />
            <path d="M150 270h360" stroke="#16181B" stroke-width="3" />
            <path class="hl p1" d="M190 330V170h300M210 300h280" fill="none" stroke="#B9B5AC" stroke-width="4" stroke-dasharray="8 8" stroke-linecap="round" stroke-linejoin="round" />
            <rect class="hl p2" x="170" y="300" width="40" height="64" rx="3" fill="#5A5E64" stroke="#16181B" stroke-width="2.5" />
            <path d="M178 316h24M178 328h24M178 340h24" stroke="#F6F3EC" stroke-width="2" />
            <g class="hl p3" fill="#fff" stroke="#16181B" stroke-width="2"><circle cx="270" cy="186" r="11" /><circle cx="400" cy="186" r="11" /><circle cx="290" cy="316" r="11" /><circle cx="400" cy="316" r="11" /></g>
            <rect class="hl p5" x="440" y="346" width="54" height="54" rx="4" fill="#9A9DA2" stroke="#16181B" stroke-width="2.5" />
            <text x="467" y="378" text-anchor="middle" fill="#fff" font-family="IBM Plex Mono, monospace" font-size="12">UPS</text>
            <g class="hl p7" fill="#fff" stroke="#16181B" stroke-width="2"><circle cx="335" cy="152" r="7" /><circle cx="335" cy="282" r="7" /><rect x="490" y="208" width="20" height="12" rx="2" /></g>
            <rect x="290" y="340" width="56" height="60" fill="#E9E4D8" stroke="#16181B" stroke-width="2" />
          </svg>
        </div>
        <div class="stack" style="--gap: 16px">
          <p class="eyebrow eyebrow--red">Unutra i vani · kliknite sustav</p>
          <h2 class="h3">Cijela zgrada, jedan izvođač.</h2>
          <ol class="stack parts" style="--gap: 6px">
            {parts.map((p, i) => (
              <li>
                <button type="button" data-set={String(i)} aria-pressed="false">
                  <span class="hd"><span class="n">{String(i + 1).padStart(2, '0')}</span>{p.label}</span>
                  <span class="d">{p.text}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- NULA PAPIROLOGIJE -->
  <section class="bg-ink">
    <div class="pe-strip" aria-hidden="true"></div>
    <div class="wrap section split">
      <div class="stack">
        <span class="display t-yellow" style="font-size: clamp(120px, 16vw, 220px); line-height: .8">0</span>
        <h2 class="h2">papirologije na vama.</h2>
      </div>
      <ul class="lines" style="border-top-width: 1px">
        <li><span>Sve potrebne studije, dozvole i certifikati</span></li>
        <li><span>Koordinacija s nadležnim tijelima kad god je potrebno</span></li>
        <li><span>Pomoć pri potporama iz fondova za energetsku učinkovitost</span></li>
      </ul>
    </div>
  </section>

  <!-- DO UPORABNE DOZVOLE -->
  <section class="wrap section">
    <div class="head">
      <div class="stack" style="--gap: 16px"><p class="eyebrow eyebrow--red">Jednostavno, učinkovito, štedljivo</p><h2 class="h2">Do uporabne dozvole — s nama.</h2></div>
      <p>Instalacije koje rade bez problema, 100 % udobnost i ušteda novca i energije. Za to smo tu.</p>
    </div>
    <div class="grid" style="--min: 230px">
      <div class="card card--top c-l1"><div class="bar"></div><div class="body"><span class="mono small muted">01</span><strong class="h4">Savjetovanje</strong><span>Što vašoj zgradi zaista treba — prije prvog poteza.</span></div></div>
      <div class="card card--top c-n"><div class="bar"></div><div class="body"><span class="mono small muted">02</span><strong class="h4">Projektiranje</strong><span>Detaljni projekti, priprema i sva dokumentacija.</span></div></div>
      <div class="card card--top"><div class="bar"></div><div class="body"><span class="mono small muted">03</span><strong class="h4">Nadzor</strong><span>Pratimo izvedbu od početka do kraja.</span></div></div>
      <div class="card card--top"><div class="bar" style="background: var(--pe-sm)"></div><div class="body"><span class="mono small muted">04</span><strong class="h4">Vođenje projekta</strong><span>Sve do trenutka kad dobijete uporabnu dozvolu.</span></div></div>
    </div>
  </section>

  <!-- NADOGRADNJE -->
  <section class="bg-white borders">
    <div class="wrap section--tight stack" style="--gap: 32px">
      <h2 class="h3">Nadogradite zgradu</h2>
      <div class="grid" style="--min: 280px">
        <a class="card bg-sand" href="/zgrade/fotonapon"><span class="mono small muted">ZGRADE</span><strong class="h3">Fotonaponski sustavi</strong><span>Vaš krov je elektrana.</span><span class="more">Otvori →</span></a>
        <a class="card bg-ink" href="/zgrade/vatrodojava"><span class="mono small muted">ZGRADE</span><strong class="h3">Vatrodojava</strong><span style="color: #D6D2C8">Uvijek budna, da vi ne morate biti.</span><span class="more t-yellow">Otvori →</span></a>
        <a class="card bg-cool" href="/zgrade/pametne-kuce"><span class="mono small muted">ZGRADE</span><strong class="h3">Pametne kuće</strong><span>Vaša zgrada, vaša pravila.</span><span class="more">Otvori →</span></a>
      </div>
    </div>
  </section>

  <Cta title="Gradite ili renovirate? Ožičit ćemo vas." secondary={{ label: 'Pošaljite nacrt', href: '/kontakt' }} />
</Base>
