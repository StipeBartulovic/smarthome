---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { contact } from '../data/site';

const areas = [
  { key: 'l1', code: 'L1', label: 'Zgrade', dot: 'var(--l1)', hint: 'vrstu objekta (kuća, stan, javna zgrada), novogradnja ili obnova, približnu površinu i treba li vam vatrodojava ili pametna kuća.', ph: 'npr. Obiteljska kuća u izgradnji, trebamo kompletne elektroinstalacije i pametnu kuću.' },
  { key: 'n', code: 'N', label: 'Obnovljivi izvori', dot: 'var(--n)', hint: 'je li riječ o domu ili tvrtki, prosječni mjesečni račun za struju, vrstu krova i zanima li vas baterija ili punionica.', ph: 'npr. Kuća s južnim krovom, zanima nas fotonapon s baterijom.' },
  { key: 'l2', code: 'L2', label: 'Industrija', dot: 'var(--l2)', hint: 'vrstu pogona, radi li se o novom pogonu ili nadogradnji, priključnu snagu i rokove.', ph: 'npr. Proširenje proizvodne hale, nova linija.' },
  { key: 'l3', code: 'L3', label: 'Promet', dot: 'var(--l3)', hint: 'dionicu, naručitelja, fazu (izgradnja, rekonstrukcija, servis, održavanje) i projektni zadatak ako ga imate.', ph: 'npr. Rekonstrukcija rasvjete na dionici [naziv].' },
  { key: 'pe', code: 'PE', label: 'Ne znam još', dot: 'linear-gradient(135deg, var(--green) 0 50%, var(--yellow) 50% 100%)', hint: 'samo ukratko što planirate — inženjer će vas nazvati i zajedno ćemo odrediti što vam treba.', ph: 'Opišite ukratko što planirate.' },
];
---
<Base title="Kontakt" description="Kontaktirajte EKP: +385 21 542 106, ekp@ekp.hr, Smiljanićeva 2, Split." active="kontakt">
  <section class="wrap" style="padding-block: 40px 56px">
    <div class="stack" style="--gap: 36px">
      <Crumbs items={[{ label: 'Kontakt' }]} />
      <div class="split split--end">
        <h1 class="h1 grow-2" style="font-size: clamp(50px, 7vw, 110px); line-height: .9">Spojimo<br /><span class="t-red">vaš projekt.</span></h1>
        <p class="lead">Volimo izazove. Recite nam nešto o projektu — ili samo nazovite.</p>
      </div>
      <div class="grid" style="--min: 260px">
        <a class="card bg-red" href={contact.phoneHref} style="min-height: 200px">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
          <span class="mono small">NAZOVITE</span>
          <span class="h4" style="margin-top: auto; font-size: 30px">{contact.phone}</span>
        </a>
        <a class="card bg-ink" href={`mailto:${contact.email}`} style="min-height: 200px">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#F2C318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
          <span class="mono small muted">PIŠITE</span>
          <span class="h4" style="margin-top: auto; font-size: 30px">{contact.email}</span>
        </a>
        <a class="card card--line" href="#karta" style="min-height: 200px">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#A51C24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
          <span class="mono small muted">SVRATITE</span>
          <span class="h4" style="margin-top: auto; font-size: 26px">Smiljanićeva 2<br />21000 Split</span>
          <span class="small muted">{contact.hours}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white borders">
    <div class="wrap section split split--top" data-state-group data-state="l1">
      <div class="stack">
        <p class="eyebrow eyebrow--red">Pošaljite upit</p>
        <h2 class="h2">Odaberite žilu — upit ide pravom timu.</h2>
        {areas.map((a) => (
          <div class="card card--paper" data-show={a.key} hidden style="border-radius: 24px; padding: 24px">
            <span class="eyebrow" style="font-size: 12px"><span class="dot" style={`background: ${a.dot}`}></span>Vaš upit ide: {a.code} · {a.label}</span>
            <strong style="font-size: 19px">Korisno je da navedete:</strong>
            <span style="color: var(--ink-2)">{a.hint}</span>
          </div>
        ))}
      </div>
      <form class="form grow-2" data-form="kontakt">
        <fieldset class="full" style="border: 0; margin: 0; padding: 0">
          <legend class="field" style="margin-bottom: 12px">Područje</legend>
          <div class="seg" role="group" aria-label="Područje upita">
            {areas.map((a) => <button type="button" data-set={a.key} data-label={`${a.code} ${a.label}`} data-placeholder={a.ph} aria-pressed="false"><span class="dot" style={`background: ${a.dot}`}></span>{a.code} · {a.label}</button>)}
          </div>
          <input type="hidden" name="podrucje" data-state-input />
        </fieldset>
        <label class="field">Ime i prezime / tvrtka<input name="ime" type="text" autocomplete="name" required /></label>
        <label class="field">Telefon<input name="telefon" type="tel" inputmode="tel" autocomplete="tel" /></label>
        <label class="field">E-mail<input name="email" type="email" autocomplete="email" required /></label>
        <label class="field">Lokacija objekta<input name="lokacija" type="text" /></label>
        <label class="field full">Poruka<textarea name="poruka" rows="5" data-placeholder-target></textarea></label>
        <label class="check full"><input type="checkbox" name="privola" value="da" required />Prihvaćam obradu podataka u svrhu odgovora na upit, prema Pravilima privatnosti.</label>
        <button type="submit" class="btn btn--red" style="justify-self: start">Pošalji upit →</button>
        <p class="form-ok full" data-form-ok hidden>Hvala! Upit je poslan, javljamo se uskoro.</p>
      </form>
    </div>
  </section>

  <section id="karta" class="wrap section grid" style="--min: 380px; --gap: 20px">
    <div class="card" style="padding: 0; overflow: hidden; border-radius: 32px; position: relative; background: #DDE3E6; min-height: 340px">
      <svg viewBox="0 0 700 420" role="img" aria-label="Stilizirana karta: ured EKP-a u Smiljanićevoj 2 u Splitu" style="width: 100%; height: 100%; object-fit: cover">
        <rect width="700" height="420" fill="#7FB3E6" />
        <path d="M0 0h700v250q-80 50-140 20-60-30-110 30-50 60-130 30-80-30-140 20-60 50-180 30z" fill="#EEF1F3" />
        <path d="M0 120l700-30M140 0l120 330M420 0l-40 300" stroke="#fff" stroke-width="12" />
        <path d="M0 220q300-20 640-50" stroke="#fff" stroke-width="8" fill="none" />
        <rect x="470" y="140" width="90" height="60" rx="6" fill="#CFE0C6" />
        <circle cx="330" cy="160" r="36" fill="#A51C24" fill-opacity=".18" />
        <path d="M330 172s-24-26-24-44a24 24 0 0 1 48 0c0 18-24 44-24 44z" fill="#A51C24" stroke="#16181B" stroke-width="2.5" />
        <circle cx="330" cy="128" r="9" fill="#fff" />
        <rect x="358" y="104" width="190" height="52" rx="14" fill="#fff" stroke="#16181B" stroke-width="2" />
        <text x="374" y="126" fill="#16181B" font-family="Archivo Variable, sans-serif" font-weight="800" font-size="16">EKP</text>
        <text x="374" y="145" fill="#55524B" font-family="IBM Plex Mono, monospace" font-size="11">Smiljanićeva 2</text>
      </svg>
      <a class="btn btn--dark" style="position: absolute; right: 20px; bottom: 20px" href="https://www.google.com/maps/search/?api=1&query=Smiljani%C4%87eva+2+Split" target="_blank" rel="noopener">Upute za dolazak →</a>
    </div>
    <div id="podaci" class="card bg-ink" style="border-radius: 32px">
      <span class="eyebrow" style="font-size: 12px">Podaci o tvrtki</span>
      <strong class="h4">{contact.company}</strong>
      <dl style="display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; font-size: 15px">
        <dt class="muted">Sjedište</dt><dd>{contact.address}</dd>
        <dt class="muted">OIB</dt><dd class="mono">HR95782162509</dd>
        <dt class="muted">MBS</dt><dd class="mono">060098984</dd>
        <dt class="muted">Registar</dt><dd>Trgovački sud u Splitu, Tt-97/2673-2</dd>
        <dt class="muted">Temeljni kapital</dt><dd>[AŽURIRATI U EUR], uplaćen u cijelosti</dd>
        <dt class="muted">Član uprave</dt><dd>Jure Grgić</dd>
        <dt class="muted">IBAN</dt><dd class="mono" style="word-break: break-all">HR8023400091100233220</dd>
        <dt class="muted">Banka</dt><dd>Privredna banka Zagreb</dd>
      </dl>
    </div>
  </section>
</Base>
