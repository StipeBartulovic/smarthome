---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import House from '../../components/ill/House.astro';
import Community from '../../components/ill/Community.astro';
import { contact } from '../../data/site';

const faqs = [
  { q: 'Rade li paneli kad je oblačno?', a: 'Da. Fotonaponski paneli proizvode struju i za oblačnih dana, a višak iz sunčanih dana možete spremiti u bateriju.' },
  { q: 'Što se događa s viškom struje?', a: 'Spremite ga u kućnu bateriju za noć ili sljedeći dan, ili ga prodate opskrbljivaču ili drugim kupcima — primjerice susjedima.' },
  { q: 'Mogu li dobiti sufinanciranje?', a: 'Pomažemo vam s prijavom na dostupne nacionalne i EU fondove za energetsku učinkovitost i zaštitu okoliša.' },
  { q: 'Koliko je održavanja potrebno?', a: 'Vrlo malo. Paneli su samočistivi, a propisani pregledi raspoređeni su kroz više godina, a ne svake godine.' },
  { q: 'Isplati li se to za moju kuću?', a: '[ODGOVOR EKP-a — npr. tipično razdoblje povrata za obiteljsku kuću u Dalmaciji.] Točan izračun dobivate nakon obilaska.' },
];
---
<Base title="Obnovljivi izvori za vaš dom" description="Fotonapon, baterije i punionice za obiteljske kuće i stambene zgrade — niži računi, auto na sunce, zajedničke elektrane." active="usluge" bodyClass="bg-cream">
  <div class="wrap row" style="justify-content: space-between; padding-top: 28px">
    <Crumbs items={[{ label: 'Obnovljivi izvori', href: '/obnovljivi-izvori' }, { label: 'Za vaš dom' }]} />
    <nav class="audience" aria-label="Odaberite publiku">
      <a href="/obnovljivi-izvori/za-dom" aria-current="page">Za vaš dom</a>
      <a href="/obnovljivi-izvori/za-tvrtke">Za tvrtke i javne zgrade</a>
    </nav>
  </div>

  <section class="wrap" style="padding-block: 40px 88px">
    <div class="split">
      <div class="stack" style="--gap: 24px">
        <span class="tag bg-yellow" style="align-self: flex-start">ZA VAŠ DOM</span>
        <h1 class="h1" style="font-stretch: 108%">Vaš dom.<br />Vaša struja.</h1>
        <p class="lead">Obnovljivi izvori za kuću su čista win-win priča: niži troškovi, manji ugljični otisak i dom koji manje ovisi o vanjskim izvorima energije.</p>
        <div class="row">
          <a class="btn btn--red" href="#upit">Dođite pogledati moj krov <span aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="#pitanja">Česta pitanja</a>
        </div>
      </div>
      <div class="ill bg-sand" style="border-radius: 40px"><House label="DANAS PROIZVEDENO" /></div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: var(--section)">
    <div class="grid" style="--min: 280px; --gap: 20px">
      <div class="card" style="border-radius: 32px"><span class="icon c-yellow"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#16181B" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v18M17 7H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6" /></svg></span><h2 class="h4" style="font-size: 28px">Manji računi</h2><p style="color: var(--ink-2)">Paneli na krovu griju dom, zagrijavaju vodu i pokreću uređaje — i kad je oblačno.</p></div>
      <div class="card" style="border-radius: 32px"><span class="icon c-n"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14l-1.5-5.5A2 2 0 0 0 15.6 10H8.4a2 2 0 0 0-1.9 1.5zM12 3l-2 4h4l-2 4" /><circle cx="8" cy="18" r="1.5" /><circle cx="16" cy="18" r="1.5" /></svg></span><h2 class="h4" style="font-size: 28px">Auto na sunce</h2><p style="color: var(--ink-2)">Punite električni ili hibridni auto kod kuće, strujom sa svog krova.</p></div>
      <div class="card" style="border-radius: 32px"><span class="icon c-green"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></span><h2 class="h4" style="font-size: 28px">Postanite proizvođač</h2><p style="color: var(--ink-2)">Višak spremite u bateriju ili ga prodajte mreži — i susjedima. Dom koji zarađuje.</p></div>
    </div>
  </section>

  <section class="bg-ink">
    <div class="wrap section split reverse">
      <div class="stack">
        <p class="eyebrow t-yellow">Zajednička elektrana</p>
        <h2 class="h2">Sa susjedima je jeftinije.</h2>
        <p class="lead">Više obiteljskih kuća ili nekoliko stambenih zgrada može se udružiti i postaviti zajednički fotonaponski sustav. Početni trošak je niži, a koristi se dijele.</p>
        <a class="btn btn--yellow" href="#upit" style="align-self: flex-start">Pitajte za zajednički sustav →</a>
      </div>
      <div class="ill" style="border-radius: 32px"><Community /></div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="h2" style="margin-bottom: 40px">Kako to ide? Jednostavno.</h2>
    <ol class="grid" style="--min: 230px; --gap: 20px">
      <li class="card" style="border-radius: 28px"><span class="display t-yellow" style="font-size: 48px; line-height: 1">1</span><strong style="font-size: 20px">Nazovete nas</strong><span style="color: var(--ink-2)">Ili ispunite kratki upit ispod.</span></li>
      <li class="card" style="border-radius: 28px"><span class="display t-yellow" style="font-size: 48px; line-height: 1">2</span><strong style="font-size: 20px">Dođemo na krov</strong><span style="color: var(--ink-2)">Procijenimo proizvodnju i povrat ulaganja.</span></li>
      <li class="card" style="border-radius: 28px"><span class="display t-yellow" style="font-size: 48px; line-height: 1">3</span><strong style="font-size: 20px">Mi rješavamo papire</strong><span style="color: var(--ink-2)">Dozvole, priključak i prijava na fondove.</span></li>
      <li class="card" style="border-radius: 28px"><span class="display t-yellow" style="font-size: 48px; line-height: 1">4</span><strong style="font-size: 20px">Vi uključite</strong><span style="color: var(--ink-2)">Montaža, puštanje u rad i održavanje.</span></li>
    </ol>
  </section>

  <section id="pitanja" class="bg-white">
    <div class="wrap narrow section stack" style="--gap: 32px">
      <h2 class="h2">Pitanja koja nam najčešće postavljate</h2>
      <div class="faq">
        {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <section id="upit" class="bg-yellow">
    <div class="wrap section--tight split">
      <div class="stack" style="--gap: 16px">
        <h2 class="h2" style="font-size: clamp(40px, 5vw, 72px); line-height: .95">Dođemo pogledati vaš krov.</h2>
        <p style="font-size: 19px">Tri polja, i javljamo se. Ili nazovite: <a href={contact.phoneHref} style="font-weight: 600">{contact.phoneShort}</a></p>
      </div>
      <form class="panel form" data-form="dom" style="align-items: end">
        <label class="field">Ime<input name="ime" type="text" autocomplete="name" required /></label>
        <label class="field">Telefon<input name="telefon" type="tel" inputmode="tel" autocomplete="tel" required /></label>
        <label class="field">Mjesto<input name="mjesto" type="text" placeholder="npr. Solin" /></label>
        <button type="submit" class="btn btn--red">Pošalji →</button>
        <p class="form-ok full" data-form-ok hidden>Hvala! Javit ćemo vam se uskoro.</p>
      </form>
    </div>
  </section>
</Base>
